{
  "name": "andrewdyer/pdf-generator",
  "description": "A framework-agnostic library for generating PDFs from Twig templates, with support for a swappable driver interface",
  "keywords": [
    "php",
    "framework-agnostic",
    "pdf",
    "pdf-generator",
    "twig",
    "html-to-pdf"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrew Dyer",
      "homepage": "https://andrewdyer.rocks",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/andrewdyer/pdf-generator",
  "support": {
    "issues": "https://github.com/andrewdyer/pdf-generator/issues",
    "source": "https://github.com/andrewdyer/pdf-generator"
  },
  "autoload": {
    "psr-4": {
      "AndrewDyer\\PdfGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndrewDyer\\PdfGenerator\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "twig/twig": "^3.27"
  },
  "require-dev": {
    "dompdf/dompdf": "^3.1",
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^10.5",
    "spatie/browsershot": "^5.4"
  },
  "suggest": {
    "dompdf/dompdf": "Required to use DompdfDriver (^3.1)",
    "spatie/browsershot": "Required to use BrowsershotDriver (^5.4). Also requires Node.js and Puppeteer."
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
